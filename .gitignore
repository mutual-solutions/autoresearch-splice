# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
worktrees/
results/
queue/

# Agent prompt files (generated per-session by launchers)
CLAUDE.md
AGENTS.md

# Experimental code/artifacts
dev/

# Results file
results.tsv

# Runtime state (must not be git-tracked — git reset --hard wipes tracked files)
.omc/autoresearch-stop
# Generic in-flight sentinels (.omc/retest-in-progress, .omc/korean-iter1-regen-in-progress, etc.)
.omc/*-in-progress

# Stale cache (see ml_eval.py note — no longer written, but guard against reappearance)
.omc/classifier/patches_korean_splice.npz

# Transient feature-extraction cache — multi-GB binary, regenerable via features.py.
# Live cache and any archived snapshot.
.omc/feature_cache/
.omc/archive/*/feature_cache_*/

# Raw source-audio pools — 20+ GB from zeroth-korean / LibriSpeech / singing
# clean WAVs. Reproducible via external downloads; not worth committing.
data/sources/

# Generated audio in eval/train/test — ~1.8 GB across 3 domains × 3 splits.
# Reproducible deterministically via `uv run python data_synth/regenerate_datasets.py
# --domain all --split all` from the source pools. Only ground_truth.json per
# split is tracked (acts as the manifest the generator populates).
data/eval/*/tier1/
data/eval/*/tier2/
data/eval/*/clean/
data/train/*/tier1/
data/train/*/tier2/
data/train/*/clean/
data/test/*/tier1/
data/test/*/tier2/
data/test/*/clean/

# Compiled Swift binaries — rebuild from source on clone
scripts/test_unlock

# Encrypted test blob — 1.1 GB. Regenerable via
#   uv run python data_synth/regenerate_datasets.py --domain all --split test
# (auto-invokes scripts/test_crypto.py setup/encrypt post-regen).
data/test.tar.gz.enc

# Encrypted eval blob — ~310 MB. Regenerable via
#   uv run python data_synth/regenerate_datasets.py --domain all --split eval
# then `uv run python scripts/eval_crypto.py encrypt`. Kept out of git so
# the authenticated encrypted corpus isn't re-uploaded to remotes; the key
# lives only in the local macOS login keychain. Claude-subprocess iterations
# never see plaintext — the wrapper decrypts to a /tmp dir and sets
# OMC_EVAL_DATA_ROOT only when invoking evaluate.py itself.
data/eval.tar.gz.enc

# US-515 unified log destination (JSONL, rotation-aware: up to 10 rolls
# at `.omc/logs/autoresearch.<iso-date>.jsonl` beside the live file).
# The sidecar `.omc/logs/child-stderr.log` holds freeform subprocess
# stdout/stderr so it cannot corrupt the JSONL stream.
.omc/logs/

# Coverage artifacts
.coverage

# SHAP sidecars are per-commit forensic output, not source code
reports/

# macOS + editor detritus
.DS_Store
.claude/

# Per-iteration evaluate.py redirected stdout (autoresearch wrapper reads it
# for RESULTS_TSV parsing — US-515 phase-3a carve-out). Mirrored into
# .omc/logs/child-stderr.log via `tee` for the unified audit trail.
.omc/last_eval.log

# Per-iteration SHAP rollup (regenerated by scripts/shap_rollup.py at the
# top of every loop iteration; churn isn't worth committing).
.omc/shap_rollup.json

# US-515 phase 2 retired `.omc/tunable_frontier.txt` — tunable_frontier.py
# emits `tunable.frontier.snapshot` to the unified log and prints the
# prompt block to stdout (captured by the wrapper directly).

# Feature-extraction cache (US-504). Pickle blobs keyed on
# (features.py sha, audio sha). Pure runtime artifact — deleteable.
.omc/feature_cache/

# Claude's iteration reflection (US-503). Wrapper captures this into
# .omc/research_notes.md as a note: commit, then truncates this file.
.omc/last_reflection.md

# US-514 retest subcommand: ephemeral state paths.
#   - .omc/retest-worktree/ is `git worktree add`ed on --retest runs and
#     torn down via atexit; crash paths may leave it behind.
#   - .omc/retest-in-progress is the SIGKILL-safety sentinel written
#     between main-tree cherry-pick and the baseline commit; loop refuses
#     to start while it exists.
#   - .omc/retest-report.md is the per-run operator report; rewritten
#     each invocation and not worth versioning.
.omc/retest-worktree/
.omc/retest-in-progress
.omc/retest-report.md

# Manual-run log spill at repo root (autoresearch loop writes to .omc/logs/).
# Operators frequently `python script.py 2>err.log >out.log` or `./run_autoresearch.sh ... > run.log`;
# without these patterns the root reaccumulates with diag/run/warnings logs between cleanups.
/*.log
/*.stderr
/*.stdout
.omc/classifier/*.log
.omc/classifier/*.stderr
.omc/classifier/*.stdout

# Ablation-sweep artifacts (e.g., sweep_duration.{json,png}) — operator
# experiment output, not repo source.
/sweep_*.png
/sweep_*.json

# US-517 supervisor_agent.py --maintain runtime state (crash counter + disable sentinel)
.omc/supervisor-crash-counter.txt
.omc/maintainer-disabled
